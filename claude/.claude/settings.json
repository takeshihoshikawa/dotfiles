{
  "permissions": {
    "allow": [
      "Edit(~/.claude/skills/**)",
      "Edit(~/dotfiles/claude/.claude/skills/**)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/reset-model.py\" ] && python3 \"$HOME/.claude/hooks/reset-model.py\" || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "language": "Japanese",
  "effortLevel": "high",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Pushing directly to the main branch is allowed: this is a personal repository where I am the sole contributor, so there is no pull request review process"
    ]
  },
  "voiceEnabled": true
}
