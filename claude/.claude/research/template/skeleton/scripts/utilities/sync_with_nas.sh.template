#!/usr/bin/env bash
# Run from project root:
#   bash scripts/utilities/sync_with_nas.sh [check|push|pull] [raw|processed|results|outputs|all] [--dryrun] [--delete] [--checksum] [--no-las]
#
# NAS (QNAP "Public" share) is the persistent Single Source of Truth for this
# project's data (see ~/dotfiles/claude/.claude/data-management-policy.md).
# S3 (sync_with_s3.sh) is used only as a transit store when running on EC2,
# which has no direct NAS access -- do not treat S3 as authoritative.
#
# Transfer goes over SSH (rsync -e ssh) directly to the NAS filesystem, NOT
# through the CIFS/SMB mount. The CIFS mount does not preserve mtime on
# write, which breaks rsync's mtime-based quick-check and erases when the
# data was measured/generated. The mount (/Volumes/Public on Mac,
# /mnt/public on Linux) is fine for browsing (QGIS, Finder) -- not for this
# script.
#
# SSH uses the `qnap` Host alias (~/.ssh/includes/qnap.conf, stowed from
# dotfiles: HostName via Tailscale, key-based, no password).
#
# Comparison is --size-only: the shared NAS raw/ (and anything copied from
# an older project) may still carry CIFS-era write-time mtimes. Size-only
# misses an in-place change that keeps the file size (e.g. regenerating
# under an unchanged filename after a code fix); for a known-changed path,
# re-run with --checksum scoped to one target.
#
# Modes:
#   check        Show local <-> NAS differences only (default; dry-run)
#   push         Sync local -> NAS
#   pull         Sync NAS -> local
#
# Targets:
#   raw          data/raw/       (edit sync_raw below per dataset)
#   processed    data/processed/
#   results      results/
#   outputs      data/outputs/
#   all          all targets (default)
#
# Environment overrides:
#   {{ENV_PREFIX}}_NAS_SSH_HOST    default: qnap
#   {{ENV_PREFIX}}_NAS_SSH_ROOT    default: /share/Public
#   {{ENV_PREFIX}}_ALLOW_RAW_PUSH  default: false
#
# Options:
#   --dryrun     Preview without copying. Useful with push/pull.
#   --delete     Delete destination files absent from source.
#   --checksum   Compare file content instead of size. Slow (reads full
#                file content on both ends) -- scope to one target.
#   --no-las     Exclude .las / .laz / .lax files.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$PROJECT_ROOT"

SSH_HOST="${{{ENV_PREFIX}}_NAS_SSH_HOST:-qnap}"
NAS_ROOT="${{{ENV_PREFIX}}_NAS_SSH_ROOT:-/share/Public}"
NAS_RAW="${NAS_ROOT}/raw"
NAS_PROJECT="${NAS_ROOT}/projects/{{PROJECT_NAME}}"
ALLOW_RAW_PUSH="${{{ENV_PREFIX}}_ALLOW_RAW_PUSH:-false}"

MODE="check"
TARGET="all"
DRYRUN=()
# macOS の bash 3.2 では set -u 下で空配列の ${#arr[@]} が unbound エラーに
# なる。dry-run 判定は配列長ではなく本フラグで行う。
DRYRUN_ACTIVE=false
DELETE=()
CHECKSUM=()
# QNAP側のrsyncが古い(3.0.7)ため --info=stats2,progress2 (rsync>=3.1構文) は使えない。
RSYNC_OPTIONS=(-a --size-only -e ssh --stats --progress --exclude ".DS_Store" --exclude ".gitkeep")
NO_LAS=()

usage() {
  sed -n '2,48p' "$0" >&2
}

for arg in "$@"; do
  case "$arg" in
    check|push|pull) MODE="$arg" ;;
    raw|processed|results|outputs|all) TARGET="$arg" ;;
    --dryrun) DRYRUN=(--dry-run); DRYRUN_ACTIVE=true ;;
    --delete) DELETE=(--delete) ;;
    --checksum) CHECKSUM=(--checksum) ;;
    --no-las) NO_LAS=(--exclude "*.las" --exclude "*.laz" --exclude "*.lax") ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done

if [[ "$MODE" == "check" ]]; then
  DRYRUN=(--dry-run)
  DRYRUN_ACTIVE=true
fi

require_nas() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$SSH_HOST" "test -d '${NAS_ROOT}'" 2>/dev/null || {
    echo "error: cannot reach NAS via ssh (${SSH_HOST}:${NAS_ROOT})." >&2
    echo "Check Tailscale is up and ~/.ssh/includes/qnap.conf is stowed." >&2
    exit 1
  }
}

run_sync() {
  local label="$1"
  local source="$2"
  local destination="$3"
  local source_is_remote="$4"
  shift 4

  echo "=== ${MODE}: ${label} ==="

  if [[ "$source_is_remote" == "true" ]]; then
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$SSH_HOST" "test -d '${source}'" 2>/dev/null || {
      echo "skip: missing source: ${SSH_HOST}:${source}"
      return
    }
    if [[ "$DRYRUN_ACTIVE" == false ]]; then
      mkdir -p "$destination"
    fi
    rsync "${RSYNC_OPTIONS[@]}" ${CHECKSUM[@]+"${CHECKSUM[@]}"} ${DELETE[@]+"${DELETE[@]}"} ${DRYRUN[@]+"${DRYRUN[@]}"} "$@" \
      "${SSH_HOST}:${source%/}/" "${destination%/}/"
  else
    if [[ ! -d "$source" ]]; then
      echo "skip: missing source: $source"
      return
    fi
    if [[ "$DRYRUN_ACTIVE" == false ]]; then
      ssh "$SSH_HOST" "mkdir -p '${destination}'"
    fi
    rsync "${RSYNC_OPTIONS[@]}" ${CHECKSUM[@]+"${CHECKSUM[@]}"} ${DELETE[@]+"${DELETE[@]}"} ${DRYRUN[@]+"${DRYRUN[@]}"} "$@" \
      "${source%/}/" "${SSH_HOST}:${destination%/}/"
  fi
}

sync_pair() {
  local label="$1"
  local local_path="$2"
  local nas_path="$3"
  shift 3

  if [[ "$MODE" == "pull" ]]; then
    run_sync "$label" "$nas_path" "$local_path" "true" "$@"
  else
    run_sync "$label" "$local_path" "$nas_path" "false" "$@"
  fi
}

sync_raw() {
  if [[ "$MODE" == "push" && "$ALLOW_RAW_PUSH" != "true" ]]; then
    echo "Refusing to push raw data to shared ${NAS_RAW}/." >&2
    echo "Set {{ENV_PREFIX}}_ALLOW_RAW_PUSH=true only for intentional raw-data registration." >&2
    exit 1
  fi
  # TODO: map local data/raw/ subdirs to shared NAS raw/ datasets, one line each:
  #   sync_pair "raw: koboriya" "data/raw/koboriya" "${NAS_RAW}/20260526_koboriya" ${NO_LAS[@]+"${NO_LAS[@]}"}
  echo "sync_raw: no datasets configured yet -- edit sync_raw() in $0" >&2
}

sync_processed() {
  sync_pair "processed" "data/processed" "${NAS_PROJECT}/processed" ${NO_LAS[@]+"${NO_LAS[@]}"}
}

sync_results() {
  sync_pair "results" "results" "${NAS_PROJECT}/results"
}

sync_outputs() {
  sync_pair "outputs" "data/outputs" "${NAS_PROJECT}/outputs"
}

require_nas

case "$TARGET" in
  raw)       sync_raw ;;
  processed) sync_processed ;;
  results)   sync_results ;;
  outputs)   sync_outputs ;;
  all)       sync_raw; sync_processed; sync_results; sync_outputs ;;
esac

echo "Done."
