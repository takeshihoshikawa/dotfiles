Include /Users/takeshi/.colima/ssh_config

IgnoreUnknown UseKeychain
Include ~/.ssh/includes/*.conf

Host *
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
Host lidar-pi lidar-pi.local
  HostName lidar-pi.local
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519_lidar_pi
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new

# テザリング経由（IPv4 は 464XLAT で遮断されるため IPv6 リンクローカルを使う）。
# アドレスは wlan0 の MAC 由来で固定。%en0 は Mac 側の Wi-Fi IF 名。
Host lidar-pi-wifi
  # ssh_config では % がエスケープ対象なので %% と書く（コマンドラインでは % のまま）
  HostName fe80::2ecf:67ff:fe12:cc07%%en0
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519_lidar_pi
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
